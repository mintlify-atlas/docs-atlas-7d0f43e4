  "keyFeatures": [
    "Multitenant Microsoft 365 management from a single interface",
    "GDAP (Granular Delegated Admin Privileges) management and onboarding",
    "Standards and baseline enforcement across tenants",
    "User lifecycle management: onboarding, offboarding, JIT admin, vacation mode",
    "Email and Exchange administration: mailboxes, transport rules, spam filters, quarantine",
    "Endpoint and Intune management: devices, applications, Autopilot profiles",
    "Security monitoring: Defender, incidents, Secure Score, risky users",
    "Conditional access policy management and templates",
    "Scheduler for recurring tasks and automated jobs",
    "Third-party integrations and SIEM connector",
    "Custom reporting, breach lookup, and executive report generation",
    "Alert and notification configuration"
  ],
  "publicApiSurface": [
